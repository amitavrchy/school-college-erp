{
  "name": "@campus-one/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "setup": "node setup/setup-env.mjs",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tooling.json",
    "test": "tsx --test test/domain.test.ts test/security.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "node --env-file-if-exists=.env node_modules/prisma/build/index.js migrate deploy",
    "db:seed": "node --env-file-if-exists=.env --import tsx prisma/seed.ts",
    "platform:bootstrap": "node --env-file-if-exists=.env --import tsx setup/bootstrap.ts",
    "test:integration": "node test/run-integration.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run db:generate && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.9",
    "@nestjs/core": "^11.1.9",
    "@nestjs/platform-express": "^11.1.9",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.9",
    "@nestjs/websockets": "^11.1.9",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.63.0",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "pdfkit": "^0.17.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "zod": "^4.1.12",
    "express-rate-limit": "^8.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/express": "^5.0.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/pdfkit": "^0.17.3",
    "prisma": "^6.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "prettier": "^3.9.10"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
