generator client {
  provider = "prisma-client-js"
}
model OrganizationMember {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id])
  userId String
  user User @relation(fields: [userId], references: [id])
  role String @default("MEMBER")
  @@unique([organizationId, userId])
}
model SubscriptionPlan {
  id String @id @default(cuid())
  code String @unique
  name String
  description String
  monthlyMinor Int
  annualMinor Int
  maxCampuses Int
  maxStudents Int
  maxStaff Int
  features String[]
  active Boolean @default(true)
  subscriptions Subscription[]
  payments SubscriptionPayment[]
}
model Subscription {
  id String @id @default(cuid())
  organizationId String @unique
  organization Organization @relation(fields: [organizationId], references: [id])
  planId String
  plan SubscriptionPlan @relation(fields: [planId], references: [id])
  status String @default("TRIAL")
  period String @default("MONTHLY")
  currentPeriodStart DateTime @default(now())
  currentPeriodEnd DateTime
  updatedAt DateTime @updatedAt
}
model SubscriptionPayment {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id])
  planId String
  plan SubscriptionPlan @relation(fields: [planId], references: [id])
  period String
  amountMinor Int
  method String
  reference String
  senderPhone String?
  status String @default("PENDING")
  submittedBy String
  reviewedBy String?
  reviewNote String?
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  @@unique([method, reference])
  @@index([organizationId, createdAt])
}
model SubscriptionEvent {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id])
  actorId String
  action String
  meta Json?
  createdAt DateTime @default(now())
  @@index([organizationId, createdAt])
}
model PlatformSettings {
  id String @id @default("platform")
  bkashNumber String?
  nagadNumber String?
  bankInstructions String?
  paymentInstructions String @default("Send the exact subscription amount, then submit your transaction reference. The platform team reviews every request before activation.")
  supportEmail String?
}
model LibraryBook {
  id String @id @default(cuid())
  campusId String
  campus Campus @relation(fields: [campusId], references: [id])
  title String
  author String
  isbn String?
  category String
  shelf String?
  totalCopies Int
  replacementMinor Int @default(0)
  loans LibraryLoan[]
  reservations LibraryReservation[]
  createdAt DateTime @default(now())
  @@index([campusId, title])
}
model LibraryLoan {
  id String @id @default(cuid())
  bookId String
  book LibraryBook @relation(fields: [bookId], references: [id])
  studentId String
  student Student @relation(fields: [studentId], references: [id])
  issuedBy String
  issuedAt DateTime @default(now())
  dueDate DateTime @db.Date
  returnedAt DateTime?
  status String @default("BORROWED")
  fineMinor Int @default(0)
  @@index([studentId, status])
}
model LibraryReservation {
  id String @id @default(cuid())
  bookId String
  book LibraryBook @relation(fields: [bookId], references: [id])
  studentId String
  student Student @relation(fields: [studentId], references: [id])
  status String @default("WAITING")
  createdAt DateTime @default(now())
  @@unique([bookId, studentId])
}
model TransportRoute {
  id String @id @default(cuid())
  campusId String
  campus Campus @relation(fields: [campusId], references: [id])
  name String
  vehicleNumber String
  driverName String
  driverPhone String
  capacity Int
  monthlyMinor Int
  active Boolean @default(true)
  stops TransportStop[]
  assignments StudentTransport[]
}
model TransportStop {
  id String @id @default(cuid())
  routeId String
  route TransportRoute @relation(fields: [routeId], references: [id])
  name String
  pickupTime String
  dropTime String
  sequence Int
  assignments StudentTransport[]
  @@unique([routeId, sequence])
}
model StudentTransport {
  id String @id @default(cuid())
  studentId String
  student Student @relation(fields: [studentId], references: [id])
  routeId String
  route TransportRoute @relation(fields: [routeId], references: [id])
  stopId String
  stop TransportStop @relation(fields: [stopId], references: [id])
  sessionId String
  session AcademicSession @relation(fields: [sessionId], references: [id])
  active Boolean @default(true)
  trips TransportTrip[]
  @@unique([studentId, sessionId])
}
model TransportTrip {
  id String @id @default(cuid())
  assignmentId String
  assignment StudentTransport @relation(fields: [assignmentId], references: [id])
  date DateTime @db.Date
  journey String
  status String
  markedBy String
  updatedAt DateTime @updatedAt
  @@unique([assignmentId, date, journey])
}
model Homework {
  id String @id @default(cuid())
  sectionId String
  section Section @relation(fields: [sectionId], references: [id])
  subjectId String
  subject Subject @relation(fields: [subjectId], references: [id])
  teacherId String
  title String
  instructions String
  dueAt DateTime
  maxPoints Int @default(100)
  allowLate Boolean @default(false)
  published Boolean @default(true)
  submissions HomeworkSubmission[]
  createdAt DateTime @default(now())
}
model HomeworkSubmission {
  id String @id @default(cuid())
  homeworkId String
  homework Homework @relation(fields: [homeworkId], references: [id])
  studentId String
  student Student @relation(fields: [studentId], references: [id])
  answer String
  submittedAt DateTime @default(now())
  points Int?
  feedback String?
  gradedBy String?
  @@unique([homeworkId, studentId])
}
model SupportTicket {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id])
  campusId String
  createdById String
  createdBy User @relation(fields: [createdById], references: [id])
  assignedToId String?
  title String
  category String
  priority String @default("NORMAL")
  status String @default("OPEN")
  slaDueAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  comments TicketComment[]
  @@index([organizationId, campusId, status])
}
model TicketComment {
  id String @id @default(cuid())
  ticketId String
  ticket SupportTicket @relation(fields: [ticketId], references: [id])
  authorId String
  author User @relation(fields: [authorId], references: [id])
  body String
  createdAt DateTime @default(now())
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model Organization {
  id String @id @default(cuid())
  name String
  campuses Campus[]
  slug String? @unique
  status String @default("ACTIVE")
  supportEmail String?
  accentColor String @default("#22644f")
  createdAt DateTime @default(now())
  members OrganizationMember[]
  subscription Subscription?
  subscriptionPayments SubscriptionPayment[]
  subscriptionEvents SubscriptionEvent[]
  tickets SupportTicket[]
}
model Campus {
  id String @id @default(cuid())
  orgId String
  organization Organization @relation(fields: [orgId], references: [id])
  name String
  code String
  address String?
  timezone String @default("Asia/Dhaka")
  sessions AcademicSession[]
  roles UserCampusRole[]
  students Student[]
  classes SchoolClass[]
  subjects Subject[]
  grades GradeScale[]
  notices Notice[]
  holidays Holiday[]
  books LibraryBook[]
  transportRoutes TransportRoute[]
  @@unique([orgId, code])
}
model AcademicSession {
  id String @id @default(cuid())
  campusId String
  campus Campus @relation(fields: [campusId], references: [id])
  name String
  startsOn DateTime @db.Date
  endsOn DateTime @db.Date
  status String @default("PLANNED")
  sections Section[]
  enrollments Enrollment[]
  applications AdmissionApplication[]
  terms ExamTerm[]
  structures FeeStructure[]
  invoices Invoice[]
  transportAssignments StudentTransport[]
  @@unique([campusId, name])
}
model User {
  id String @id @default(cuid())
  email String @unique
  phone String?
  fullName String
  fullNameBn String?
  passwordHash String
  active Boolean @default(true)
  tokenVersion Int @default(0)
  platformAdmin Boolean @default(false)
  memberships OrganizationMember[]
  tickets SupportTicket[]
  ticketComments TicketComment[]
  roles UserCampusRole[]
  guardians GuardianStudent[]
  student Student?
  assignments SectionSubjectTeacher[]
}
model UserCampusRole {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  campusId String
  campus Campus @relation(fields: [campusId], references: [id])
  role String
  @@unique([userId, campusId, role])
}
model GuardianStudent {
  guardianUserId String
  guardian User @relation(fields: [guardianUserId], references: [id])
  studentId String
  student Student @relation(fields: [studentId], references: [id])
  relation String @default("Parent")
  isPrimary Boolean @default(false)
  @@id([guardianUserId, studentId])
}
model Student {
  id String @id @default(cuid())
  campusId String
  campus Campus @relation(fields: [campusId], references: [id])
  userId String? @unique
  user User? @relation(fields: [userId], references: [id])
  studentCode String
  fullName String
  fullNameBn String?
  dob DateTime? @db.Date
  gender String?
  bloodGroup String?
  guardians GuardianStudent[]
  enrollments Enrollment[]
  invoices Invoice[]
  payments Payment[]
  leaves LeaveRequest[]
  waivers Waiver[]
  libraryLoans LibraryLoan[]
  libraryReservations LibraryReservation[]
  transportAssignments StudentTransport[]
  homeworkSubmissions HomeworkSubmission[]
  @@unique([campusId, studentCode])
}
model SchoolClass {
  id String @id @default(cuid())
  campusId String
  campus Campus @relation(fields: [campusId], references: [id])
  name String
  numericLevel Int
  sections Section[]
  structures FeeStructure[]
  applications AdmissionApplication[]
  @@unique([campusId, numericLevel])
}
model Section {
  id String @id @default(cuid())
  classId String
  schoolClass SchoolClass @relation(fields: [classId], references: [id])
  sessionId String
  session AcademicSession @relation(fields: [sessionId], references: [id])
  name String
  capacity Int @default(40)
  shift String @default("MORNING")
  classTeacherId String?
  enrollments Enrollment[]
  assignments SectionSubjectTeacher[]
  offers SeatOffer[]
  slots TimetableSlot[]
  homework Homework[]
  @@unique([classId, sessionId, name])
}
model Enrollment {
  id String @id @default(cuid())
  studentId String
  student Student @relation(fields: [studentId], references: [id])
  sectionId String
  section Section @relation(fields: [sectionId], references: [id])
  sessionId String
  session AcademicSession @relation(fields: [sessionId], references: [id])
  status String @default("ACTIVE")
  rollNumber String?
  attendance AttendanceRecord[]
  marks ExamMark[]
  @@unique([studentId, sessionId])
  @@index([sectionId])
}
model Subject {
  id String @id @default(cuid())
  campusId String
  campus Campus @relation(fields: [campusId], references: [id])
  name String
  code String
  compulsory Boolean @default(true)
  assignments SectionSubjectTeacher[]
  marks ExamMark[]
  slots TimetableSlot[]
  homework Homework[]
  @@unique([campusId, code])
}
model SectionSubjectTeacher {
  id String @id @default(cuid())
  sectionId String
  section Section @relation(fields: [sectionId], references: [id])
  subjectId String
  subject Subject @relation(fields: [subjectId], references: [id])
  teacherId String
  teacher User @relation(fields: [teacherId], references: [id])
  @@unique([sectionId, subjectId])
}
model AdmissionApplication {
  id String @id @default(cuid())
  sessionId String
  session AcademicSession @relation(fields: [sessionId], references: [id])
  applyingClassId String
  applyingClass SchoolClass @relation(fields: [applyingClassId], references: [id])
  status String @default("SUBMITTED")
  applicantName String
  guardianPhone String
  guardianEmail String?
  testScore Float @default(0)
  previousGpa Float @default(0)
  meritRank Int?
  offerExpiresAt DateTime?
  createdAt DateTime @default(now())
  offer SeatOffer?
  documents AdmissionDocument[]
}
model AdmissionDocument {
  id String @id @default(cuid())
  applicationId String
  application AdmissionApplication @relation(fields: [applicationId], references: [id])
  fileName String
  mimeType String
  size Int
  encryptedData Bytes
  createdAt DateTime @default(now())
  @@index([applicationId])
}
model SeatOffer {
  id String @id @default(cuid())
  applicationId String @unique
  application AdmissionApplication @relation(fields: [applicationId], references: [id])
  sectionId String
  section Section @relation(fields: [sectionId], references: [id])
  status String @default("OFFERED")
  acceptanceToken String @unique @default(uuid())
}
model AttendanceRecord {
  id String @id @default(cuid())
  enrollmentId String
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id])
  date DateTime @db.Date
  status String
  period Int @default(0)
  markedBy String
  @@unique([enrollmentId, date, period])
  @@index([date, status])
}
model LeaveRequest {
  id String @id @default(cuid())
  studentId String
  student Student @relation(fields: [studentId], references: [id])
  fromDate DateTime @db.Date
  toDate DateTime @db.Date
  status String @default("REQUESTED")
  reason String
}
model ExamTerm {
  id String @id @default(cuid())
  sessionId String
  session AcademicSession @relation(fields: [sessionId], references: [id])
  name String
  status String @default("SETUP")
  weightBps Int @default(10000)
  entryDeadline DateTime?
  marks ExamMark[]
}
model ExamMark {
  id String @id @default(cuid())
  termId String
  term ExamTerm @relation(fields: [termId], references: [id])
  enrollmentId String
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id])
  subjectId String
  subject Subject @relation(fields: [subjectId], references: [id])
  marksObtained Decimal @db.Decimal(6,2)
  maxMarks Decimal @default(100) @db.Decimal(6,2)
  isAbsent Boolean @default(false)
  @@unique([termId, enrollmentId, subjectId])
}
model GradeScale {
  id String @id @default(cuid())
  campusId String
  campus Campus @relation(fields: [campusId], references: [id])
  minMarks Float
  maxMarks Float
  letter String
  point Float
}
model FeeStructure {
  id String @id @default(cuid())
  sessionId String
  session AcademicSession @relation(fields: [sessionId], references: [id])
  classId String
  schoolClass SchoolClass @relation(fields: [classId], references: [id])
  name String
  heads FeeHead[]
}
model FeeHead {
  id String @id @default(cuid())
  structureId String
  structure FeeStructure @relation(fields: [structureId], references: [id])
  name String
  amountMinor Int
  frequency String @default("MONTHLY")
}
model Invoice {
  id String @id @default(cuid())
  studentId String
  student Student @relation(fields: [studentId], references: [id])
  sessionId String
  session AcademicSession @relation(fields: [sessionId], references: [id])
  status String @default("DUE")
  dueDate DateTime @db.Date
  totalMinor Int
  paidMinor Int @default(0)
  fineMinor Int @default(0)
  waivedMinor Int @default(0)
  currency String @default("BDT")
  generationKey String? @unique
  lines InvoiceLine[]
  allocations PaymentAllocation[]
  waivers Waiver[]
  @@index([studentId, status])
}
model InvoiceLine {
  id String @id @default(cuid())
  invoiceId String
  invoice Invoice @relation(fields: [invoiceId], references: [id])
  feeHeadName String
  amountMinor Int
}
model Payment {
  id String @id @default(cuid())
  studentId String
  student Student @relation(fields: [studentId], references: [id])
  provider String
  status String @default("PENDING")
  amountMinor Int
  idempotencyKey String @unique
  providerRef String? @unique
  paidAt DateTime?
  createdAt DateTime @default(now())
  allocations PaymentAllocation[]
}
model PaymentAllocation {
  id String @id @default(cuid())
  paymentId String
  payment Payment @relation(fields: [paymentId], references: [id])
  invoiceId String
  invoice Invoice @relation(fields: [invoiceId], references: [id])
  amountMinor Int
  @@unique([paymentId, invoiceId])
}
model Waiver {
  id String @id @default(cuid())
  studentId String
  student Student @relation(fields: [studentId], references: [id])
  invoiceId String
  invoice Invoice @relation(fields: [invoiceId], references: [id])
  feeHeadName String
  amountMinor Int
  reason String
  requestedBy String
  approvedBy String?
  status String @default("REQUESTED")
}
model Notice {
  id String @id @default(cuid())
  campusId String
  campus Campus @relation(fields: [campusId], references: [id])
  title String
  body String
  bodyBn String?
  audience Json
  channels String[]
  status String @default("DRAFT")
  scheduledAt DateTime?
  createdAt DateTime @default(now())
  messages SmsMessage[]
}
model SmsMessage {
  id String @id @default(cuid())
  campusId String
  toPhone String
  body String
  status String @default("QUEUED")
  providerRef String?
  dedupeKey String @unique
  noticeId String?
  notice Notice? @relation(fields: [noticeId], references: [id])
  createdAt DateTime @default(now())
}
model TimetableSlot {
  id String @id @default(cuid())
  sectionId String
  section Section @relation(fields: [sectionId], references: [id])
  dayOfWeek Int
  period Int
  subjectId String
  subject Subject @relation(fields: [subjectId], references: [id])
  teacherId String
  room String?
  @@unique([sectionId, dayOfWeek, period])
  @@unique([teacherId, dayOfWeek, period])
}
model Holiday {
  id String @id @default(cuid())
  campusId String
  campus Campus @relation(fields: [campusId], references: [id])
  name String
  date DateTime @db.Date
  @@unique([campusId, date])
}
model AuditLog {
  id String @id @default(cuid())
  actorId String?
  campusId String?
  action String
  entity String
  entityId String?
  meta Json?
  createdAt DateTime @default(now())
  @@index([campusId, createdAt])
}
