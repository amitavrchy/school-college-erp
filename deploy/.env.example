# /opt/apps/erp/.env  (chmod 600) — read by both containers (env_file).
# NEVER commit real values.

# --- Core (required) -------------------------------------------------------
# Shared Postgres on the apps-net Docker network; own role + database "erp".
DATABASE_URL=postgresql://erp:CHANGE_ME@shared-postgres:5432/erp?schema=public
# Shared Valkey (Redis-compatible). Required: BullMQ jobs, rate limits and /api/health use it. db 4 = erp.
REDIS_URL=redis://:CHANGE_ME@shared-redis:6379/4
# Generate: openssl rand -hex 48  (min 32 chars)
JWT_ACCESS_SECRET=
# Generate: openssl rand -hex 32  (exactly 64 hex chars; encrypts admission documents)
DOCUMENT_ENCRYPTION_KEY=
# Public frontend origin; also used by the frontend proxy to tell the ERP host from school-site hosts.
APP_URL=https://erp.13.203.3.1.sslip.io
# Comma-separated browser origins allowed for CORS / state-changing requests.
CORS_ORIGINS=https://erp.13.203.3.1.sslip.io,https://api.erp.13.203.3.1.sslip.io
COOKIE_SECURE=true
# Frontend runtime (src/proxy.ts, school-site fetches). Also baked as a build arg.
API_INTERNAL_URL=http://erp-backend:4000

# --- Platform owner (setup/bootstrap.ts: `npm run platform:bootstrap`) -------
PLATFORM_ADMIN_EMAIL=platform@campusone.edu.bd
# >= 16 chars. Only needed when running the bootstrap/seed; can be removed afterwards.
PLATFORM_SEED_PASSWORD=
# Demo seed (prisma/seed.ts) password for the demo school users, >= 12 chars. Optional.
SEED_PASSWORD=

# --- Payments (third-party; manual = record payments by hand) ---------------
PAYMENT_MODE=manual
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

# --- SMS (third-party; console = log only) ----------------------------------
SMS_PROVIDER=console
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# --- Business rules ----------------------------------------------------------
FEE_FINE_PER_DAY_MINOR=1000
ADMISSION_OFFER_HOURS=48
SIBLING_DISCOUNT_BPS=0
FEE_REMINDERS_ENABLED=false

# --- School websites ----------------------------------------------------------
# School sites are served at https://<subdomain>.<SCHOOL_SITE_BASE_DOMAIN>
SCHOOL_SITE_BASE_DOMAIN=erp.13.203.3.1.sslip.io
# Hostname schools point their custom-domain CNAME at (needs a real domain; see deploy/README.md).
SCHOOL_SITE_CNAME_TARGET=
